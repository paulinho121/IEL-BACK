# Porta HTTP da API
PORT=3333
# Endereço público da API, usado para montar a URL das imagens
APP_URL=http://localhost:3333

# Banco de dados MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=digital_store

# Segredo usado para assinar os tokens JWT (troque por um valor longo e aleatório)
JWT_SECRET=troque-este-segredo
# Validade do token
JWT_EXPIRES_IN=1d
