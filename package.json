{
  "name": "digital-store-api",
  "version": "1.0.0",
  "description": "API da Digital Store - projeto final de Back-end da Digital College",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:create": "sequelize db:create",
    "db:migrate": "sequelize db:migrate",
    "db:seed": "sequelize db:seed:all",
    "db:reset": "sequelize db:migrate:undo:all && sequelize db:migrate && sequelize db:seed:all",
    "test": "cross-env NODE_ENV=test jest --runInBand",
    "db:migrate:prod": "cross-env NODE_ENV=production ENV_FILE=.env.production sequelize db:migrate",
    "db:seed:prod": "cross-env NODE_ENV=production ENV_FILE=.env.production sequelize db:seed:all"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/paulinho121/IEL-BACK.git"
  },
  "author": "Paulo Fernando",
  "license": "MIT",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/paulinho121/IEL-BACK/issues"
  },
  "homepage": "https://github.com/paulinho121/IEL-BACK#readme",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.6",
    "sequelize": "^6.37.8",
    "sequelize-cli": "^6.6.5",
    "swagger-ui-express": "^5.0.1",
    "cross-env": "^10.1.0"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "sqlite3": "^6.0.1",
    "supertest": "^7.3.2"
  },
  "engines": {
    "node": ">=20"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/tests/setupEnv.js"
    ]
  }
}
